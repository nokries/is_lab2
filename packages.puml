@startuml
top to bottom direction
skinparam packageStyle rectangle
skinparam shadowing false

package "frontend" as front {
    [Vue 3 / Vite]
}

package "controllers" as ctrl {
    [REST-контроллеры]
    [AuthenticationController]
    [ImportController]
    [ExceptionHandler]
}

package "services" as svc {
    [Сервисы ЛР1]
    [AuthenticationService]
    [ImportService]
    [ImportOperationService]
    [SerializableTransaction]
}

package "repository" as repo {
    [Spring Data JPA]
}

package "config" as cfg {
    [SecurityConfig]
    [YamlConfig]
    [EclipseLinkConfig]
    [WebSocketConfig]
}

package "filters" as filters {
    [JwtFilter]
}

package "hadlers" as handlers {
    [CustomLogoutHandler]
    [CustomAccessDeniedHandler]
}

package "models.dto" as dto {
    [DTO объектов и операций]
}

package "models.entity" as ent {
    [Сущности JPA]
}

package "utils" as utils {
    [Мапперы MapStruct]
}

package "exceptions" as exc {
    [Исключения импорта и конфликтов]
}

database "PostgreSQL" as db

front ..> ctrl : HTTP /api
front ..> cfg : WebSocket /ws
cfg ..> filters : подключает JWT-фильтр
cfg ..> handlers : выход и отказ в доступе
filters ..> svc : токен и пользователь
handlers ..> repo : отзыв токена

ctrl ..> svc : вызывает сервисы
ctrl ..> dto : принимает и возвращает DTO
ctrl ..> exc : формирует ответ об ошибке
svc ..> repo : читает и сохраняет данные
svc ..> cfg : настройки чтения YAML
svc ..> utils : преобразует объекты
svc ..> dto : данные запросов и ответов
svc ..> exc : выбрасывает исключения
utils ..> dto
utils ..> ent
repo ..> ent : JPA
repo ..> db : SQL

@enduml