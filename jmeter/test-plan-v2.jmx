<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="IS Lab2 - параллельная работа пользователей" enabled="true">
      <stringProp name="TestPlan.comments">Проверка изоляции транзакций и ограничений уникальности при одновременной работе нескольких пользователей. Параметры: -JHOST=localhost -JPORT=8080 -JTHREADS=10</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp: подготовка (пользователи, файлы, целевые объекты)">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Инициализация прогона" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Уникальный идентификатор прогона: имена объектов не пересекаются с прошлыми запусками
// Каждый запуск получает новый RUN_ID: JMeter в GUI хранит свойства между запусками,
// а при старом RUN_ID регистрация пользователей дала бы &quot;уже существует&quot;
props.setProperty(&quot;RUN_ID&quot;, String.valueOf(System.currentTimeMillis()))
// Количество потоков (по умолчанию 10; задаётся ключом -JTHREADS=N)
if (props.getProperty(&quot;THREADS&quot;) == null) {
    props.setProperty(&quot;THREADS&quot;, &quot;10&quot;)
}
// Сбрасываем счётчики результатов прошлого запуска (если JMeter запущен в GUI повторно)
props.stringPropertyNames().findAll { it.startsWith(&quot;CNT_&quot;) }.each { props.remove(it) }
String run = props.getProperty(&quot;RUN_ID&quot;)
vars.put(&quot;RUN&quot;, run)

// Файлы для импорта создаются на лету, чтобы имена объектов были уникальными для каждого прогона
File dir = new File(System.getProperty(&quot;java.io.tmpdir&quot;), &quot;is_lab2_import_&quot; + run)
dir.mkdirs()
def record = { String name, String extra = &quot;&quot; -&gt;
    return &quot;&quot;&quot;  - name: &quot;${name}&quot;
    coordinates: { x: 10, y: 20 }
    age: 30
    creatureType: HOBBIT
    attackLevel: 7
    creatureLocation: { name: &quot;City ${name}&quot;, area: 100.5, population: 100, governor: HUMAN, capital: false, populationDensity: 5 }
    ring: { name: &quot;Ring ${name}&quot;, power: 3, weight: 1${extra} }
&quot;&quot;&quot;
}
// 1) корректный файл из трёх записей: его импортируют все потоки одновременно (должен пройти ровно один раз)
new File(dir, &quot;valid.yaml&quot;).setText(&quot;creatures:\n&quot; + record(&quot;IMP_&quot; + run + &quot;_1&quot;) + record(&quot;IMP_&quot; + run + &quot;_2&quot;) + record(&quot;IMP_&quot; + run + &quot;_3&quot;), &quot;UTF-8&quot;)
// 2) файл, где первая запись корректна, а вторая нарушает ограничение (x &gt; 735): не должно создаться ничего
String bad = record(&quot;IMPBAD_&quot; + run + &quot;_1&quot;) + record(&quot;IMPBAD_&quot; + run + &quot;_2&quot;).replace(&quot;x: 10,&quot;, &quot;x: 9999,&quot;)
new File(dir, &quot;invalid.yaml&quot;).setText(&quot;creatures:\n&quot; + bad, &quot;UTF-8&quot;)
// 3) файл из одной записи с именем, за которое соревнуются импорт и обычное создание
new File(dir, &quot;mix.yaml&quot;).setText(&quot;creatures:\n&quot; + record(&quot;MIX_&quot; + run), &quot;UTF-8&quot;)
// 4) файл для проверки истории импорта
new File(dir, &quot;history.yaml&quot;).setText(&quot;creatures:\n&quot; + record(&quot;HIST_&quot; + run + &quot;_1&quot;), &quot;UTF-8&quot;)
props.setProperty(&quot;IMPORT_DIR&quot;, dir.getAbsolutePath())
log.info(&quot;IS Lab2: RUN_ID=&quot; + run + &quot;, THREADS=&quot; + props.getProperty(&quot;THREADS&quot;) + &quot;, files: &quot; + dir.getAbsolutePath())
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Регистрация администраторов (по одному на поток)" enabled="true">
          <stringProp name="LoopController.loops">${__P(THREADS,10)}</stringProp>
        </LoopController>
        <hashTree>
          <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Номер пользователя" enabled="true">
            <stringProp name="CounterConfig.start">1</stringProp>
            <stringProp name="CounterConfig.end"></stringProp>
            <stringProp name="CounterConfig.incr">1</stringProp>
            <stringProp name="CounterConfig.name">userNum</stringProp>
            <stringProp name="CounterConfig.format"></stringProp>
            <boolProp name="CounterConfig.per_user">false</boolProp>
          </CounterConfig>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Register admin ${userNum}" enabled="true">
            <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(PORT,8080)}</stringProp>
