        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="CHECK 7: импорт с ошибкой - у всех 400" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Проверка итогов сценария TG7
int n = (props.getProperty(&quot;THREADS&quot;) ?: &quot;10&quot;) as int
def checks = []
def check = { String code, String actualStr, String rule, int threads -&gt;
    int actual = actualStr as int
    boolean ok
    String expected
    switch (rule) {
        case &quot;N&quot;:   expected = String.valueOf(threads);     ok = (actual == threads); break
        case &quot;N-1&quot;: expected = String.valueOf(threads - 1); ok = (actual == threads - 1); break
        case &quot;&gt;=1&quot;: expected = &quot;&gt;= 1&quot;;                      ok = (actual &gt;= 1); break
        case &quot;1&quot;:   expected = &quot;1&quot;;                         ok = (actual == 1); break
        case &quot;0&quot;:   expected = &quot;0&quot;;                         ok = (actual == 0); break
        default:    expected = rule; ok = (String.valueOf(actual) == rule)
    }
    return [ok: ok, text: &quot;код &quot; + code + &quot;: получено &quot; + actual + &quot;, ожидалось &quot; + expected + (ok ? &quot; - OK&quot; : &quot; - ОШИБКА&quot;)]
}
checks &lt;&lt; check(&quot;400&quot;, props.getProperty(&quot;CNT_TG7_400&quot;) ?: &quot;0&quot;, &quot;N&quot;, n)
// Любой код ответа, не перечисленный в правилах, считается ошибкой (например, 500)
def known = [&quot;400&quot;]
props.stringPropertyNames().findAll { it.startsWith(&quot;CNT_TG7_&quot;) }.each { k -&gt;
    String code = k.substring(&quot;CNT_TG7_&quot;.length())
    if (!known.contains(code)) {
        checks &lt;&lt; [ok: false, text: &quot;неожиданный код &quot; + code + &quot;: &quot; + props.getProperty(k) + &quot; раз - ОШИБКА&quot;]
    }
}
boolean allOk = checks.every { it.ok }
SampleResult.setSuccessful(allOk)
SampleResult.setResponseMessage(allOk ? &quot;OK&quot; : &quot;ОШИБКА&quot;)
SampleResult.setResponseData(checks.collect { it.text }.join(&quot;\n&quot;), &quot;UTF-8&quot;)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
