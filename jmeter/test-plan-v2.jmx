            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// Считаем ответы по кодам: CNT_TG3_&lt;код ответа&gt;
def key = &quot;CNT_TG3_&quot; + prev.getResponseCode()
synchronized (props) {
    int n = (props.getProperty(key) ?: &quot;0&quot;) as int
    props.setProperty(key, String.valueOf(n + 1))
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
