        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="CHECK 8: импорт против создания - успешный ответ ровно один" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">int i200 = (props.getProperty(&quot;CNT_TG8I_200&quot;) ?: &quot;0&quot;) as int
int i409 = (props.getProperty(&quot;CNT_TG8I_409&quot;) ?: &quot;0&quot;) as int
int c200 = (props.getProperty(&quot;CNT_TG8C_200&quot;) ?: &quot;0&quot;) as int
int c409 = (props.getProperty(&quot;CNT_TG8C_409&quot;) ?: &quot;0&quot;) as int
int n = (props.getProperty(&quot;THREADS&quot;) ?: &quot;10&quot;) as int
boolean good = (i200 + c200 == 1) &amp;&amp; (i200 + i409 + c200 + c409 == n)
SampleResult.setSuccessful(good)
SampleResult.setResponseMessage(good ? &quot;OK&quot; : &quot;ОШИБКА&quot;)
SampleResult.setResponseData(&quot;импорт: 200=&quot; + i200 + &quot;, 409=&quot; + i409 + &quot;; создание: 200=&quot; + c200 + &quot;, 409=&quot; + c409 + (good ? &quot; - OK&quot; : &quot; - ОШИБКА (успешным должен быть ровно один запрос)&quot;), &quot;UTF-8&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
