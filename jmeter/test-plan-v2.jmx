        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create target for UPDATE+DELETE" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
