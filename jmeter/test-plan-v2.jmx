          <stringProp name="parameters"></stringProp>
          <stringProp name="script">int n = (props.getProperty(&quot;THREADS&quot;) ?: &quot;10&quot;) as int
int ok = (props.getProperty(&quot;CNT_TG3_200&quot;) ?: &quot;0&quot;) as int
int conflict = (props.getProperty(&quot;CNT_TG3_409&quot;) ?: &quot;0&quot;) as int
boolean good = (ok &gt;= 1) &amp;&amp; (ok + conflict == n)
SampleResult.setSuccessful(good)
SampleResult.setResponseMessage(good ? &quot;OK&quot; : &quot;ОШИБКА&quot;)
SampleResult.setResponseData(&quot;200: &quot; + ok + &quot;, 409: &quot; + conflict + &quot;, потоков: &quot; + n + (good ? &quot; - OK&quot; : &quot; - ОШИБКА (все ответы должны быть 200 или 409, хотя бы один 200)&quot;), &quot;UTF-8&quot;)</stringProp>
