              <stringProp name="script">// Допустимые коды ответа: 200, 404, 409. Они считаются успехом (даже 4xx - так задумано сценарием).
// Любой другой код (особенно 500) - ошибка
def allowed = [&quot;200&quot;, &quot;404&quot;, &quot;409&quot;]
boolean ok = allowed.contains(prev.getResponseCode())
prev.setSuccessful(ok)
if (!ok) {
    prev.setResponseMessage(&quot;Недопустимый код ответа &quot; + prev.getResponseCode() + &quot;, ожидалось: &quot; + allowed.join(&quot;, &quot;))
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Подсчёт кодов ответа" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Считаем ответы по кодам: CNT_TG5U_&lt;код ответа&gt;
def key = &quot;CNT_TG5U_&quot; + prev.getResponseCode()
synchronized (props) {
    int n = (props.getProperty(key) ?: &quot;0&quot;) as int
    props.setProperty(key, String.valueOf(n + 1))
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
