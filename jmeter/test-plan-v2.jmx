        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="CHECK 5: изменение+удаление - один 204 на удаление, нет 500" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">int n = (props.getProperty(&quot;THREADS&quot;) ?: &quot;10&quot;) as int
int deleters = (int) (n / 2)            // чётные потоки
int updaters = n - deleters             // нечётные потоки
int d204 = (props.getProperty(&quot;CNT_TG5D_204&quot;) ?: &quot;0&quot;) as int
int d404 = (props.getProperty(&quot;CNT_TG5D_404&quot;) ?: &quot;0&quot;) as int
int u200 = (props.getProperty(&quot;CNT_TG5U_200&quot;) ?: &quot;0&quot;) as int
int u404 = (props.getProperty(&quot;CNT_TG5U_404&quot;) ?: &quot;0&quot;) as int
int u409 = (props.getProperty(&quot;CNT_TG5U_409&quot;) ?: &quot;0&quot;) as int
boolean good = (d204 == 1) &amp;&amp; (d204 + d404 == deleters) &amp;&amp; (u200 + u404 + u409 == updaters)
SampleResult.setSuccessful(good)
SampleResult.setResponseMessage(good ? &quot;OK&quot; : &quot;ОШИБКА&quot;)
SampleResult.setResponseData(&quot;удаление: 204=&quot; + d204 + &quot;, 404=&quot; + d404 + &quot; (потоков &quot; + deleters + &quot;); изменение: 200=&quot; + u200 + &quot;, 404=&quot; + u404 + &quot;, 409=&quot; + u409 + &quot; (потоков &quot; + updaters + &quot;)&quot; + (good ? &quot; - OK&quot; : &quot; - ОШИБКА&quot;), &quot;UTF-8&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
